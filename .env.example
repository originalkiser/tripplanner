# Copy to .env.local and fill in from the Supabase project dashboard (Settings > API).
# Never commit .env.local.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Server-side only (Edge Functions / Supabase Vault) — do NOT prefix with VITE_,
# do NOT reference from client code. Set these via `supabase secrets set` instead
# of a client .env file:
#   SUPABASE_SERVICE_ROLE_KEY
#   OPENROUTESERVICE_API_KEY (Phase 5, admin-provided via Settings > Integrations)
